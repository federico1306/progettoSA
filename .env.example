# ============================================================================
# AI Assisted Software Architecting Council — Environment Configuration
# ============================================================================
# The system supports multiple LLM families out of the box.
# You can configure EITHER a single OpenRouter key (which routes to Gemini,
# Llama, Mistral, Qwen, DeepSeek, Claude, GPT) OR individual provider keys.
# If no API key is set (or LLM_MODE=mock), the system uses the built-in
# deterministic Context-Aware Architectural Simulator so the Live Demo and
# Evaluation Suite work out-of-the-box in <1 minute.

# Mode: "auto" (uses real API keys if present, falls back to simulator), "live", or "mock"
LLM_MODE=auto

# Option A: Single OpenRouter API Key (Recommended - routes to 3+ distinct LLM families)
OPENROUTER_API_KEY=

# Option B: Direct Provider API Keys (Free tiers available on Google AI Studio & Groq)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model Family Assignments for Each Council Seat (customizable)
# Seat 1: Pragmatist (Family A - Google Gemini)
AGENT_PRAGMATIST_PROVIDER=gemini
AGENT_PRAGMATIST_MODEL=gemini-2.0-flash

# Seat 2: Guardian (Family B - Meta Llama via Groq/OpenRouter)
AGENT_GUARDIAN_PROVIDER=groq
AGENT_GUARDIAN_MODEL=llama-3.3-70b-versatile

# Seat 3: Innovator (Family C - Mistral / Qwen via OpenRouter/Groq)
AGENT_INNOVATOR_PROVIDER=openrouter
AGENT_INNOVATOR_MODEL=mistralai/mistral-small-3.1-24b-instruct:free

# Seat 4: Skeptic (Family D - DeepSeek / Qwen via Groq/OpenRouter)
AGENT_SKEPTIC_PROVIDER=groq
AGENT_SKEPTIC_MODEL=qwen-qwq-32b

# Chair Agent (Moderator & ADR Synthesizer)
AGENT_CHAIR_PROVIDER=gemini
AGENT_CHAIR_MODEL=gemini-2.0-flash

# Debate Protocol Bounds
MAX_CRITIQUE_ROUNDS=2
CONSENSUS_THRESHOLD=0.65
SERVER_PORT=8000

